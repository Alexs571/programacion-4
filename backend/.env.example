# Copiar este archivo como .env y completar los datos de tu PostgreSQL.
# El .env NO se sube al repositorio ni va en el zip.

# Conexión a la base (crear antes la base vacía foodstore_db).
# Para probar rápido sin PostgreSQL se puede usar: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Clave para firmar los JWT: mínimo 32 caracteres. Se puede generar con
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

# Algoritmo de firma del JWT
ALGORITHM=HS256

# Minutos que duran el token y la cookie
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
